# Copy this file to .env.local and fill in the values you need.
# Never commit .env.local — it is ignored by git.

# Public URL of the deployed site. Used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Inquiry delivery ──────────────────────────────────────────────
# Configure ONE of the options below. If neither is set, inquiries are
# printed to the server console in development and REJECTED in production
# (visitors see an error asking them to call or email instead).

# Option A — email via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be an address on a domain you verified in Resend.
CONTACT_FROM_EMAIL=

# Option B — POST the inquiry as JSON to a webhook
# (e.g. a Google Apps Script, Zapier, Make, n8n or your own backend)
CONTACT_WEBHOOK_URL=
# Optional shared secret, sent as the "X-Webhook-Secret" header.
CONTACT_WEBHOOK_SECRET=
